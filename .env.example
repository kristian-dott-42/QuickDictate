# QuickDictate config — copy to ~/.dictate/.env and fill in your keys
#
# At minimum, set ONE of these provider blocks. The defaults below use Groq
# for both transcription and cleanup (fastest + cheapest).

# ── Groq (recommended — free tier is generous, ~10× faster than OpenAI) ──────
# Get a key at https://console.groq.com
GROQ_API_KEY=gsk_...

STT_URL=https://api.groq.com/openai/v1/audio/transcriptions
STT_KEY=gsk_...
STT_MODEL=whisper-large-v3-turbo

LLM_URL=https://api.groq.com/openai/v1/chat/completions
LLM_KEY=gsk_...
LLM_MODEL=llama-3.1-8b-instant

# ── OpenAI (alternative) ─────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# Leave STT_URL/LLM_URL unset to use OpenAI's defaults (whisper-1, gpt-4o-mini)

# ── Vocabulary hint to improve transcription accuracy ────────────────────────
# Comma-separated list of names, brands, technical terms you use often.
# WHISPER_PROMPT=YourName, YourCompany, brand1, brand2, technical term,

# ── Custom cleanup prompt (optional) ─────────────────────────────────────────
# Overrides the built-in cleanup instructions. The raw transcript is sent
# wrapped in <dictation> tags. Leave unset to use the sensible default, which
# removes fillers, fixes punctuation, resolves self-corrections, and keeps
# British spelling. Set this only if you want different behaviour.
# CLEANUP_PROMPT=Clean up the dictation. Keep it verbatim, only remove "um" and "uh".

# ── Hotkey (read at launch — restart the app after changing) ──────────────────
# HOTKEY_KEYCODE: which key is push-to-talk. 63 = fn (default), 61 = right option.
# HOTKEY_EXCLUSIVE: default false. When false, the hotkey is observed but passed
#   straight through, so it still works normally for everything else.
#   Set to true ONLY if you need to stop other apps from also seeing the hotkey
#   (it then consumes the key). The keyboard cannot freeze either way — the tap
#   runs on its own thread — but if the app ever misbehaves you can always
#   force-quit it from Activity Monitor.
# HOTKEY_KEYCODE=63
# HOTKEY_EXCLUSIVE=false
